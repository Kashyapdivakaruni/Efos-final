# PrediHealth Configuration

# Google Cloud Vision API Key (for cloud OCR fallback)
# Get this from: https://console.cloud.google.com/
# When set, enables Document Text Detection (better than local pytesseract)
# If not set, will fall back to local pytesseract (requires system-installed Tesseract)
GOOGLE_VISION_API_KEY=

# Optional: Database URL (defaults to SQLite)
# DATABASE_URL=sqlite:///./predihealth.db

# Optional: API Port (defaults to 8000)
# API_PORT=8000

# Optional: Ollama service URL for health reports and chatbot
# OLLAMA_BASE=http://localhost:11434
# OLLAMA_MODEL=llama3.2
